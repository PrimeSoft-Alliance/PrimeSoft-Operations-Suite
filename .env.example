# GROQ_API_KEY: Required for Groq AI API calls with extended thinking and vision capabilities.
# Get your API key from https://console.groq.com
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/plumber_system?retryWrites=true&w=majority"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="myemail@gmail.com"
SMTP_PASS="myapppassword"
JWT_SECRET="mysupersecretjwtkey"
SUPERADMIN_SETUP_SECRET="platform_init_secret"
