# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/plumber_system?retryWrites=true&w=majority"
GROQ_API_KEY="MY_GROQ_API_KEY"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="myemail@gmail.com"
SMTP_PASS="myapppassword"
JWT_SECRET="mysupersecretjwtkey"
SUPERADMIN_SETUP_SECRET="platform_init_secret"
VITE_FACEBOOK_APP_ID="YOUR_FACEBOOK_APP_ID"
WHATSAPP_VERIFY_TOKEN="your_secret_verify_token"
